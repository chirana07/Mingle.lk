# ----------------------------------------------------
# Project Katha (Mingle.lk) - Environment Variables
# Copy this file to .env before starting services
# ----------------------------------------------------

# Environment: development | production | test
ENVIRONMENT=development
DEBUG=True

# Backend API Configuration
# Default is zero-config local SQLite (uncomment for PostgreSQL):
DATABASE_URL=sqlite+aiosqlite:///./katha.db
# For local PostgreSQL or Docker Compose setup:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mingle_lk
# DATABASE_URL=postgresql+asyncpg://mingle_user:mingle_password@db:5432/mingle_lk

# Security & Authentication
SECRET_KEY=katha-super-secret-investor-demo-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# CORS & Frontend Origins
FRONTEND_URL=http://localhost:3000

# Admin Credentials (For initial dashboard access)
ADMIN_EMAIL=admin@mingle.lk
ADMIN_PASSWORD=AdminKathaSecure2026!

# Frontend Public API URL (Used by Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
